DATABASE_URL=file:./dev.db

# Google AI Studio API Key (Option 1)
# GEMINI_API_KEY=your-api-key-here

# Google Cloud Vertex AI Credentials (Option 2)
# Place your Service Account JSON key at ./gcp-credentials.json or set the path below:
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# AI_PROVIDER=auto # 'auto', 'vertex', or 'gemini'
