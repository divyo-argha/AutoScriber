generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TranscriptionJob {
  id          String   @id @default(cuid())
  fileName    String
  fileSize    Int
  duration    Float?
  status      String   @default("pending") // pending, uploading, chunking, processing, completed, failed, cancelled
  controlStatus String @default("running") // running, paused, cancel_requested, cancelled
  progress    Int      @default(0) // 0-100
  model       String   @default("gemini-2.0-flash")
  language    String   @default("bn")
  chunksTotal Int      @default(0)
  chunksDone  Int      @default(0)
  errorMessage String?
  result      String?  // JSON string of transcription segments
  chunkResults String? // JSON array of intermediate per-chunk results
  audioPath   String?  // Path to saved audio file for playback from history
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSettings {
  id                 String @id @default("default")
  aiProvider         String @default("auto") // "auto", "gemini", or "vertex"
  geminiApiKey       String @default("")
  geminiApiBaseUrl   String @default("")
  gcpProjectId       String @default("")
  gcpLocation        String @default("us-central1")
  gcpCredentialsPath String @default("")
  gcpCredentialsJson String @default("")
  sonioxApiKey       String @default("")
  defaultModel       String @default("gemini-2.0-flash")
  chunkDuration      Int    @default(600) // 10 minutes (600 seconds)
  overlapDuration    Int    @default(30)  // 30 seconds overlap
}
