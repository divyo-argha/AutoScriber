generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TranscriptionJob {
  id          String   @id @default(cuid())
  fileName    String
  fileSize    Int
  duration    Float?
  status      String   @default("pending") // pending, uploading, chunking, processing, completed, failed
  progress    Int      @default(0) // 0-100
  model       String   @default("gemini-2.5-flash")
  language    String   @default("bn")
  chunksTotal Int      @default(0)
  chunksDone  Int      @default(0)
  errorMessage String?
  result      String?  // JSON string of transcription segments
  chunkResults String? // JSON array of intermediate per-chunk results
  audioPath   String?  // Path to saved audio file for playback from history
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSettings {
  id              String @id @default("default")
  geminiApiKey    String @default("")
  geminiApiBaseUrl String @default("")
  sonioxApiKey    String @default("")
  defaultModel    String @default("gemini-2.5-flash")
  chunkDuration   Int    @default(600) // 10 minutes (600 seconds)
  overlapDuration Int    @default(30)  // 30 seconds overlap
}
